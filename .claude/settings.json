{
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'vp_env=\"${XDG_CONFIG_HOME:-$HOME/.config}/vite-plus/env\"; if [ -f \"$vp_env\" ]; then . \"$vp_env\"; fi' >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/validate-exports.sh",
            "if": "Bash(git commit *)"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  }
}
