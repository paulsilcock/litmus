{
  "name": "@litmus-ts/ai",
  "version": "0.1.0-rc.2",
  "description": "AI SDK adapters for the Litmus framework.",
  "homepage": "https://github.com/paulsilcock/litmus#readme",
  "bugs": {
    "url": "https://github.com/paulsilcock/litmus/issues"
  },
  "license": "MIT",
  "author": "Paul Silcock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulsilcock/litmus.git",
    "directory": "packages/ai"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#litmus-ai/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./openai": "./src/openai/index.ts",
    "./openai/testing": "./src/openai/testing/index.ts",
    "./vercel": "./src/vercel/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@litmus-ts/core": "workspace:*",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "ai": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "ai": "^6.0.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
