  },
  "dependencies": {
    "@litmus/core": "workspace:*",
    "yargs-parser": "^21.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/yargs-parser": "^21.0.3",
    "vite-plus": "catalog:",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "zod": "^3.24.0"
  }
}
