{
  "name": "@litmus/cli",
  "version": "0.0.0",
  "description": "CLI entrypoint adapter for the Litmus framework.",
  "homepage": "https://github.com/paulsilcock/litmus#readme",
  "bugs": {
    "url": "https://github.com/paulsilcock/litmus/issues"
  },
  "license": "MIT",
  "author": "Paul Silcock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulsilcock/litmus.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#litmus-cli/*": "./src/*"
  },
  "exports": {
