{
  "name": "@litmus/core",
  "version": "0.0.0",
  "description": "Domain primitives and base classes for the Litmus framework.",
  "homepage": "https://github.com/paulsilcock/litmus#readme",
  "bugs": {
    "url": "https://github.com/paulsilcock/litmus/issues"
  },
  "license": "MIT",
  "author": "Paul Silcock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulsilcock/litmus.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#litmus/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./db/drizzle-postgres": "./src/db/drizzle-postgres/index.ts",
    "./repo/drizzle-postgres": "./src/repo/drizzle-postgres/index.ts",
    "./id": "./src/id.ts",
    "./events": "./src/domain/domain-event-dispatcher.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.2",
    "@types/node": "^25.5.0",
    "drizzle-kit": "^0.31.10",
    "vite-plus": "catalog:"
  }
}
