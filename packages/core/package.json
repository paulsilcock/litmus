{
  "name": "@litmus/core",
  "version": "0.0.0",
  "description": "Domain primitives and base classes for the Litmus framework.",
  "homepage": "https://github.com/paulsilcock/litmus#readme",
  "bugs": {
    "url": "https://github.com/paulsilcock/litmus/issues"
  },
  "license": "MIT",
  "author": "Paul Silcock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulsilcock/litmus.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#litmus/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./ai": "./src/ai.ts",
    "./db": "./src/db/db-context.ts",
    "./events": "./src/domain/domain-event-dispatcher.ts",
    "./id": "./src/id.ts",
    "./log": "./src/log.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "reflect-metadata": "catalog:",
    "tsyringe": "catalog:",
    "ulidx": "^2.4.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.7.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  }
}
