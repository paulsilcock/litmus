  "bugs": {
    "url": "https://github.com/paulsilcock/litmus/issues"
  },
  "license": "MIT",
  "author": "Paul Silcock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulsilcock/litmus.git",
    "directory": "packages/http"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#litmus-http/*": "./src/*"
