    "@opentelemetry/context-async-hooks": "^2.7.0",
    "@opentelemetry/core": "^2.7.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@litmus-ts/test": "workspace:*",
    "@types/node": "catalog:",
    "hono": "catalog:",
    "reflect-metadata": "catalog:",
    "tsyringe": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
