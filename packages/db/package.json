{
  "name": "@litmus/db",
  "version": "0.0.0",
  "description": "Database adapters for the Litmus framework.",
  "homepage": "https://github.com/paulsilcock/litmus#readme",
  "bugs": {
    "url": "https://github.com/paulsilcock/litmus/issues"
  },
  "license": "MIT",
  "author": "Paul Silcock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulsilcock/litmus.git",
    "directory": "packages/db"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#litmus-db/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./drizzle/postgres": "./src/drizzle/postgres/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@litmus/core": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.2",
    "@types/node": "^25.5.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
