{
  "name": "@litmus-ts/db",
  "version": "0.0.0",
  "description": "Database adapters for the Litmus framework.",
  "homepage": "https://github.com/paulsilcock/litmus#readme",
  "bugs": {
    "url": "https://github.com/paulsilcock/litmus/issues"
  },
  "license": "MIT",
  "author": "Paul Silcock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulsilcock/litmus.git",
    "directory": "packages/db"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#litmus-db/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./drizzle/postgres": "./src/drizzle/postgres/index.ts",
    "./drizzle/postgres/test": "./src/drizzle/postgres/test/index.ts",
    "./test-support/fixtures": "./src/test-support/fixtures.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@litmus-ts/core": "workspace:*",
    "reflect-metadata": "catalog:",
    "tsyringe": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "vite-plus": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    },
    "vite-plus": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
